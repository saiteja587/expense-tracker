# Copy to .env.local for local development. See README.md → Environment variables.

# Neon Postgres connection string. Set automatically on Vercel when you connect
# a Neon database from the Storage tab; for local dev copy it from Vercel
# (Settings > Environment Variables) or the Neon console.
DATABASE_URL=

# Any long random string. Vercel Cron sends it to the cron endpoints; without
# it the daily jobs refuse to run.
CRON_SECRET=

# Push notifications: generate with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Shared secret for /api/notify-water?secret=... (external scheduler).
WATER_NOTIFY_SECRET=

# Optional. Session signing secret; generated and stored in the DB if unset.
AUTH_SECRET=

# Optional. Free TMDB key (themoviedb.org) for real movie posters.
TMDB_API_KEY=

# Optional. Timezone that decides when "today" starts (default Asia/Kolkata).
APP_TIMEZONE=
